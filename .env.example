VITE_BACKEND=local
VITE_API_BASE_URL=http://localhost:8080
VITE_API_TOKEN=dev-token

# docker-compose.prod.yml on CT111 reads these values from /opt/savings-planner/.env.
# Keep real passwords/tokens outside git.
IMAGE_REGISTRY=192.168.100.165:3000/jakub
IMAGE_TAG=latest
DB_HOST=192.168.100.164
DB_PORT=5432
DB_NAME=finance
DB_USER=app_user
DB_PASSWORD=change-me
API_TOKEN=change-me
CORS_ALLOWED_ORIGINS=http://savings.lan
# Comma-separated own source account numbers used to mark internal bank transfers.
# Keep real account numbers only in CT111 /opt/savings-planner/.env.
INTERNAL_TRANSFER_SOURCE_ACCOUNTS=
# Optional private Ollama fallback for transaction categorization.
LLM_ENABLED=false
LLM_BASE_URL=http://192.168.100.7:11434
LLM_MODEL=qwen3:14b
LLM_MIN_CONFIDENCE=0.70
LLM_TIMEOUT_SECONDS=30
