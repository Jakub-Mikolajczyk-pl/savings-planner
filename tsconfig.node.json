{
  "compilerOptions": {
    /*
     * Osobny cache dla plików uruchamianych w Node.
     */
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    /*
     * Ten projekt nie ma DOM, bo vite.config.ts działa w Node, nie w przeglądarce.
     * Dlatego lib ma tylko ES2023, a typy to "node".
     */
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    /*
     * Konfiguracja Vite też używa ESM import/export, więc resolution zostaje
     * spójne z aplikacją.
     */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /*
   * Tutaj sprawdzamy tylko pliki konfiguracyjne uruchamiane poza przeglądarką.
   */
  "include": ["vite.config.ts"]
}
